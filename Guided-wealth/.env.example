# Newsletter / market-digest feature (Guided-wealth Vercel project)
# TEMPLATE ONLY — copy these keys into .env (local) or Vercel env vars and fill
# real values there. NEVER put real secrets in this file.
#
# These are the ONLY things needed — no database. Brevo stores subscribers.

# Brevo (free): https://app.brevo.com  -> SMTP & API -> API Key
BREVO_API_KEY=
# Brevo contact-list ID that holds the newsletter subscribers
BREVO_LIST_ID=
# Verified sender address shown in the "From" field
BREVO_SENDER_EMAIL=guidedwealthy@gmail.com

# Financial data comes from Yahoo Finance public endpoints + an RSS feed — NO key needed.
# Optional overrides if a section comes back empty:
# YAHOO_INDEX_MAP=SENSEX:^BSESN,NIFTY 50:^NSEI,NIFTY BANK:^NSEBANK,USD/INR:INR=X
# YAHOO_WATCH_SYMBOLS=RELIANCE.NS,TCS.NS,HDFCBANK.NS
# NEWS_RSS_URL=https://economictimes.indiatimes.com/rssfeeds/-2128936835.cms

# Long random string; Vercel Cron sends it as Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Public base URL used to build the unsubscribe link in emails
NEWSLETTER_SITE_URL=https://guided-wealthy.vercel.app
